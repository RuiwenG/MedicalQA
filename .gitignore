# Python
__pycache__/
*.py[cod]
*.egg-info/

# Secrets — API keys. Never commit. Share .env.example instead.
.env
.env.*
!.env.example

# Virtual environments
.mvenv/
.venv/
venv/
env/

# Slurm job logs
slurm/*.out
slurm/*.err

# Local model weights (loaded by absolute path on HPC)
BGE-M3/
*.safetensors
*.gguf

# Generated vector store
RAG/temp_rag_chroma_db/

# Pipeline artifacts (regenerated by the pipelines)
debug_chunk.json
chunks.json
Intermediate.json

# Audio (regenerated by preprocess.py / Whisper)
Master/*/Audio/

# OS / editor
.DS_Store
.idea/
.vscode/
# Human evaluation outputs (per-annotator checkpoints + result spreadsheets)
eval/results/

# LLM-judge raw output (regenerated by eval/llm_judge/judge*.py; the scripts and
# the analysis are versioned, the per-run JSONL and logs are not — same rule as
# eval/results/ above)
eval/llm_judge/runs/

# LaTeX build products
paper/*.log
paper/*.aux
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.synctex.gz

# Named SingleAgent prompt arms, kept on disk for the prompt comparison and not
# versioned here — `SingleAgent/` is the live arm the eval site reads, and each
# of these is a snapshot of one generation of it:
#   SingleAgent-v1  pre-self-containment prompt   git show 124efa1:"<ds>/<n>/SingleAgent/QA results/finalQA.json"
#   SingleAgent-v2  self-contained prompt         git show 447a972:"<ds>/<n>/SingleAgent/QA results/finalQA.json"
#   SingleAgent-v3  current prompt                copy of the live SingleAgent/ folder
# v1 and v2 reproduce from the commits above. v3 only exists on disk until the
# current SingleAgent/ outputs are committed — back it up before deleting it.
**/SingleAgent-v[0-9]/

# Duplicate of SingleAgent-v1 under the old name; slated for removal.
**/SingleAgent-prev/

# Throwaway old-definition judge used for the replication run
eval/llm_judge/judge_olddef.py
