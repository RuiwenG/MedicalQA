# Python
__pycache__/
*.py[cod]
*.egg-info/

# Secrets — API keys. Never commit. Share .env.example instead.
.env
.env.*
!.env.example

# Virtual environments
.mvenv/
.venv/
venv/
env/

# Slurm job logs
slurm/*.out
slurm/*.err

# Local model weights (loaded by absolute path on HPC)
BGE-M3/
*.safetensors
*.gguf

# Generated vector store
RAG/temp_rag_chroma_db/

# Pipeline artifacts (regenerated by the pipelines)
debug_chunk.json
chunks.json
Intermediate.json

# Audio (regenerated by preprocess.py / Whisper)
Master/*/Audio/

# OS / editor
.DS_Store
.idea/
.vscode/
# Human evaluation outputs (per-annotator checkpoints + result spreadsheets)
eval/results/

# LLM-judge raw output (regenerated by eval/llm_judge/judge*.py; the scripts and
# the analysis are versioned, the per-run JSONL and logs are not — same rule as
# eval/results/ above)
eval/llm_judge/runs/

# LaTeX build products
paper/*.log
paper/*.aux
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.synctex.gz

# Pre-prompt-change SingleAgent outputs. Materialised from git history purely as
# a comparison arm for the self-containment evaluation; reproduce with
#   git show <commit>:"<dataset>/<n>/SingleAgent/QA results/finalQA.json"
**/SingleAgent-prev/
