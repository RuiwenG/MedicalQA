# Copy to .env and fill in. .env is gitignored - never commit real keys.
#
#   cp .env.example .env

# --- Which backend the pipelines use -----------------------------------------
# api   = OpenAI-compatible HTTP endpoint (default)
# local = load Qwen weights with transformers, as the SLURM jobs do
QWEN_BACKEND=api

# --- API backend --------------------------------------------------------------
QWEN_API_KEY=your-key-here

# Model id as the provider names it.
#
# IMPORTANT for the four-approach comparison: video 1 was generated with the
# open-weight Qwen3.5-9B. Only that model keeps later videos comparable to it.
#   qwen/qwen3.5-9b  via QWEN_PROVIDER=openrouter  <- same weights as the HPC run
#   qwen3.5-flash    via QWEN_PROVIDER=dashscope   <- different (proprietary) model
#   qwen3.5-plus     via QWEN_PROVIDER=dashscope   <- different (proprietary) model
QWEN_MODEL=qwen/qwen3.5-9b

# Pick an endpoint one of three ways (checked in this order):
#   1. QWEN_BASE_URL  - an explicit URL, wins over everything
#   2. QWEN_PROVIDER  - dashscope | dashscope-cn | deepinfra | together | openrouter
#   3. VLLM_POD_ENDPOINT - a self-hosted vLLM pod serving Qwen
# Default is dashscope (Alibaba Model Studio, Singapore).
#
# NOTE: leaving BOTH of the first two unset falls through to VLLM_POD_ENDPOINT,
# so set one explicitly unless you mean to hit your own pod.
QWEN_PROVIDER=openrouter
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# How to tell the server not to emit reasoning tokens. Qwen3.5 thinks by
# default; these pipelines never read the trace, and leaving it on multiplies
# the output-token bill.
#   dashscope  -> extra_body {"enable_thinking": false}
#   vllm       -> extra_body {"chat_template_kwargs": {"enable_thinking": false}}
#   openrouter -> extra_body {"reasoning": {"enabled": false}}
#   none       -> send nothing (rely on stripping <think> from the response)
QWEN_THINKING_PARAM=openrouter

# --- Self-hosted vLLM pod (optional alternative to a hosted provider) ---------
# VLLM_POD_ENDPOINT=https://your-pod-host/v1
# VLLM_POD_API_KEY=your-pod-key
# QWEN_THINKING_PARAM=vllm
